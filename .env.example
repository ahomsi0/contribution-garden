# ── Live GitHub data (server-side only) ─────────────────────────────────────
# Create one GitHub OAuth App at https://github.com/settings/applications/new
# and keep this pair on the server. Visitors never sign in or see these values.
# For local development use:
#   Homepage URL:            http://localhost:3000
#   Authorization callback:  http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional legacy backend fallback used only when the OAuth App pair above is
# absent. Prefer the OAuth App credentials.
GITHUB_TOKEN=

# ── Optional visitor sign-in (GitHub App user authorization) ────────────────
# The garden UI does not require visitors to connect an account. These values
# enable the optional /api/auth/github/* session routes for private
# contribution details. GITHUB_SESSION_SECRET must be at least 32 characters.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
GITHUB_SESSION_SECRET=

# ── Operations ───────────────────────────────────────────────────────────────
# Public base URL used for canonical/OG metadata in production, e.g.
# https://garden.example.com
NEXT_PUBLIC_SITE_URL=

# Requests per minute per client IP for GET /api/github/:username.
# Default 60 when unset.
GARDEN_API_RATE_LIMIT=60

# Log verbosity for server-side structured logs: debug | info | warn | error.
LOG_LEVEL=info
